    <script>
        // Authentication Step 1 -> Step 2
        function handleSendOTP(event) {
            event.preventDefault();
            const serviceIdInput = document.getElementById('service-id').value;
            if(serviceIdInput) {
                document.getElementById('display-card-no').innerText = serviceIdInput.toUpperCase();
                document.getElementById('auth-step-1').style.display = 'none';
                document.getElementById('auth-step-2').style.display = 'block';
            }
        }

        // Reset Auth Step back to ID
        function resetAuthStep() {
            document.getElementById('auth-step-2').style.display = 'none';
            document.getElementById('auth-step-1').style.display = 'block';
        }

        // Verify OTP and Unlock Website
        function handleVerifyOTP(event) {
            event.preventDefault();
            const overlay = document.getElementById('auth-overlay');
            overlay.style.opacity = '0';
            overlay.style.transition = 'opacity 0.4s ease';
            setTimeout(() => {
                overlay.style.display = 'none';
            }, 400);
        }

        // Canteen Modal Toggles
        function openCanteenModal() {
            document.getElementById('canteen-modal').classList.add('active');
        }

        function closeCanteenModal() {
            document.getElementById('canteen-modal').classList.remove('active');
        }

        // Select Canteen Location
        function selectCanteen(name, address, element) {
            document.querySelectorAll('.canteen-item-card').forEach(card => {
                card.classList.remove('selected');
                const icon = card.querySelector('.fa-circle-check');
                if(icon) {
                    icon.className = 'fa-regular fa-circle';
                    icon.style.color = '#CBD5E1';
                }
            });

            element.classList.add('selected');
            const currentIcon = element.querySelector('.fa-circle, .fa-circle-check');
            if(currentIcon) {
                currentIcon.className = 'fa-solid fa-circle-check text-olive';
                currentIcon.style.color = '';
            }

            document.getElementById('active-canteen-name').innerHTML = `${name} <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>`;
            document.getElementById('banner-canteen-title').innerText = name;
            document.getElementById('banner-canteen-address').innerHTML = `<i class="fa-solid fa-location-dot"></i> ${address}`;

            closeCanteenModal();
        }

        // Cart Drawer Toggles
        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('active');
        }

        // Category Filter & Section Scrolling
        function filterCategory(category, element) {
            document.querySelectorAll('.cat-item').forEach(item => item.classList.remove('active'));
            element.classList.add('active');

            const cards = document.querySelectorAll('.product-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });

            if(category !== 'all') {
                const targetSec = document.getElementById(`sec-${category}`);
                if(targetSec) {
                    targetSec.scrollIntoView({ behavior: 'smooth' });
                }
            }
        }

        // Add to Cart Simulation
        let currentCartCount = 2;
        function addToCart(title, price, type, imgUrl) {
            currentCartCount++;
            document.getElementById('cart-count').innerText = currentCartCount;

            const list = document.getElementById('cart-items-list');
            const newItem = document.createElement('div');
            newItem.className = 'cart-item';
            
            newItem.innerHTML = `
                <div class="cart-item-img">
                    <img src="${imgUrl}" alt="${title}">
                </div>
                <div class="cart-item-info">
                    <h5>${title}</h5>
                    <div style="font-size: 0.8rem; font-weight: 700; color: var(--olive-accent);">₹${price.toLocaleString()}</div>
                    <div class="qty-controls">
                        <button class="qty-btn">-</button>
                        <span style="font-size: 0.85rem; font-weight: 600;">1</span>
                        <button class="qty-btn">+</button>
                    </div>
                </div>
                <i class="fa-solid fa-trash-can" style="color: var(--danger); cursor: pointer; font-size: 0.9rem;" onclick="this.parentElement.remove();"></i>
            `;

            list.appendChild(newItem);
            toggleCartDrawer();
        }

        // Checkout simulation
        function handleCheckout() {
            alert("Smart Card Authentication Verified! Pickup token generated for collection at selected Unit Run Canteen.");
            toggleCartDrawer();
        }
    </script>
