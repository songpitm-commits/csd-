                                <i class="fa-solid fa-building-columns"></i>
                                <select id="category-select" class="form-control" style="padding-left: 2.5rem;" required>
                                    <option value="">Select Service Branch</option>
                                    <option value="army" selected>Indian Army</option>
                                    <option value="navy">Indian Navy</option>
                                    <option value="airforce">Indian Air Force</option>
                                    <option value="coastguard">Indian Coast Guard</option>
                                    <option value="veterans">Ex-Servicemen / Veteran (ESM)</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.8rem;">
                            Send OTP Code <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>

                <!-- Step 2: OTP Entry -->
                <div id="auth-step-2" style="display: none;">
                    <div style="text-align: center; margin-bottom: 1.5rem;">
                        <span class="badge badge-olive"><i class="fa-solid fa-mobile-screen"></i> Verification Code Sent</span>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem;">
                            Enter 4-digit OTP sent to registered mobile linked with <strong id="display-card-no" class="text-olive">JC-489012W</strong>.
                        </p>
                    </div>

                    <form id="form-otp" onsubmit="handleVerifyOTP(event)">
                        <div class="form-group">
                            <label style="text-align: center;">Security OTP Code</label>
                            <div class="otp-inputs">
                                <input type="text" maxlength="1" class="otp-digit form-control" value="7" required>
                                <input type="text" maxlength="1" class="otp-digit form-control" value="3" required>
                                <input type="text" maxlength="1" class="otp-digit form-control" value="9" required>
                                <input type="text" maxlength="1" class="otp-digit form-control" value="1" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-gold" style="width: 100%; padding: 0.8rem; margin-top: 1rem;">
