            font-size: 0.75rem;
            padding: 0.5rem;
            border-radius: 4px;
            text-align: center;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        /* FOOTER & SOCIAL HANDLES */
        footer {
            background-color: var(--navy-primary);
            color: var(--white);
            padding: 3.5rem 2rem 1.5rem;
            margin-top: auto;
            border-top: 4px solid var(--gold-primary);
        }

        .footer-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
